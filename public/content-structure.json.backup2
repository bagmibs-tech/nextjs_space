        {
          "section_id": "about_snapshot",
          "type": "content_block",
          "content": {
            "en": {
              "h2": "HumanAIze: Your AI-Business Orchestrator",
              "body": "HumanAIze is a boutique consultancy helping DACH and UAE enterprises translate AI and digital ambitions into measurable business value.\n\nAs an AI-Business orchestrator, we sit at the intersection of strategy, technology, data, and delivery partners. Instead of isolated pilots or vendor-led projects, we align everything around your P&L KPIs, regulatory environment, and culture—from Germany to the Gulf.\n\nFrom AI opportunity mapping to 90-day MVPs and scaled rollouts, we own the roadmap, the execution, and the ROI narrative.",
              "metrics": [
                {
                  "value": "25+",
                  "label": "Years in digital & AI transformation"
                },
                {
                  "value": "90 Days",
                  "label": "to first measurable ROI"
                },
                {
                  "value": "30%+",
                  "label": "Efficiency gains"
                },
                {
                  "value": "18%",
                  "label": "Revenue upliftment"
                }
              ]
            },
            "de": {
              "h2": "HumanAIze: Ihr KI-Business-Orchestrator",
              "body": "HumanAIze ist eine Boutique-Beratung, die DACH- und VAE-Unternehmen dabei hilft, KI- und Digital-Ambitionen in messbaren Geschäftswert zu übersetzen.\n\nAls KI-Business-Orchestrator stehen wir an der Schnittstelle von Strategie, Technologie, Daten und Delivery-Partnern. Statt isolierter Piloten oder herstellergesteuerter Projekte richten wir alles an Ihren GuV-KPIs, regulatorischen Anforderungen und Ihrer Unternehmenskultur aus – von Deutschland bis zum Golf.\n\nVon der KI-Opportunity-Kartierung über 90-Tage-MVPs bis hin zu skalierten Rollouts übernehmen wir die Roadmap, die Umsetzung und die ROI-Narrative.",
              "metrics": [
                {
                  "value": "25+",
                  "label": "Jahre in digitaler & KI-Transformation"
                },
                {
                  "value": "90 Tage",
                  "label": "bis zum ersten messbaren ROI"
                },
                {
                  "value": "30%+",
                  "label": "Effizienzgewinne"
                },
                {
                  "value": "18%",
                  "label": "Umsatzsteigerung"
                }
              ]
            }
          }
        },

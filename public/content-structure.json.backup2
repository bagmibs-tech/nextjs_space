    {
      "page_id": "services",
      "url": "/services",
      "seo": {
        "en": {
          "title": "Services – AI Strategy, Digital Transformation & Enterprise Architecture | HumanAIze",
          "meta_description": "Comprehensive AI and digital transformation services for DACH and UAE enterprises. From SAP modernization to ROI-as-a-Service."
        },
        "de": {
          "title": "Leistungen – KI-Strategie, Digitale Transformation & Enterprise Architecture | HumanAIze",
          "meta_description": "Umfassende KI- und Digital-Transformations-Services für DACH- und VAE-Unternehmen. Von SAP-Modernisierung bis ROI-as-a-Service."
        }
      },
      "sections": [
        {
          "section_id": "intro",
          "type": "hero",
          "content": {
            "en": {
              "h1": "Services: From Strategy to Scaled AI ROI in DACH & UAE",
              "body": "We don't push tools. We orchestrate strategy, architecture, delivery partners and change so your AI and digital investments pay off fast—whether your plants are in Bavaria or your HQ is in Dubai."
            },
            "de": {
              "h1": "Leistungen: Von der Strategie zum skalierten KI-ROI in DACH & VAE",
              "body": "Wir verkaufen keine Tools. Wir orchestrieren Strategie, Architektur, Delivery-Partner und Change, damit sich Ihre KI- und Digital-Investitionen schnell auszahlen – ob Ihre Werke in Bayern oder Ihr Hauptsitz in Dubai sind."
            }
          }
        },
        {
          "section_id": "digital_transformation",
          "type": "service_detail",
          "anchor": "digital-transformation",
          "content": {
            "en": {
              "h2": "Digital Transformation: SAP & Cloud for DACH & UAE",
              "description": "Modernize your ERP and cloud landscape in a way that respects DACH regulations and leverages UAE speed and innovation.",
              "sub_services": [
                {
                  "title": "SAP Consulting & Implementation",
                  "details": [
                    "Roadmap from ECC to S/4HANA or optimization of existing S/4HANA",
                    "Process harmonization across DACH plants and UAE operations",
                    "Integration with MES, CRM and industry solutions",
                    "KPI focus: process lead time, error rates, automation level, audit readiness"
                  ]
                },
                {
                  "title": "Cloud Transformation & FinOps",
                  "details": [
                    "Cloud strategy covering EU data residency and UAE hosting options",
                    "Secure, compliant migration with cost governance",
                    "FinOps frameworks tuned to multi-region setups",
                    "KPIs: infrastructure cost/unit, uptime, deployment frequency, incident reduction"
                  ]
                }
              ],
              "outcomes": [
                "15–30% reduction in process cycle time",
                "20–28% IT cost optimization",
                "Improved audit and compliance readiness across both regions"
              ]
            },
            "de": {
              "h2": "Digitale Transformation: SAP & Cloud für DACH & VAE",
              "description": "Modernisieren Sie Ihre ERP- und Cloud-Landschaft so, dass DACH-Vorschriften respektiert und VAE-Geschwindigkeit und Innovation genutzt werden.",
              "sub_services": [
                {
                  "title": "SAP-Beratung & Implementierung",
                  "details": [
                    "Roadmap von ECC zu S/4HANA oder Optimierung bestehender S/4HANA",
                    "Prozessharmonisierung über DACH-Werke und VAE-Betriebe hinweg",
                    "Integration mit MES, CRM und Branchenlösungen",
                    "KPI-Fokus: Prozessdurchlaufzeit, Fehlerquoten, Automatisierungsgrad, Audit-Bereitschaft"
                  ]
                },
                {
                  "title": "Cloud-Transformation & FinOps",
                  "details": [
                    "Cloud-Strategie mit EU-Datenresidenz und VAE-Hosting-Optionen",
                    "Sichere, compliance-konforme Migration mit Kostensteuerung",
                    "FinOps-Frameworks für Multi-Region-Setups",
                    "KPIs: Infrastrukturkosten/Einheit, Verfügbarkeit, Deployment-Frequenz, Incident-Reduktion"
                  ]
                }
              ],
              "outcomes": [
                "15–30% Reduktion der Prozessdurchlaufzeit",
                "20–28% IT-Kostenoptimierung",
                "Verbesserte Audit- und Compliance-Bereitschaft in beiden Regionen"
              ]
            }
          }
        },
        {
          "section_id": "ai_strategy",
          "type": "service_detail",
          "anchor": "ai-strategy",
          "content": {
            "en": {
              "h2": "AI Strategy & ROI-as-a-Service for DACH & UAE",
              "description": "Turn AI into a portfolio of measurable initiatives, not scattered pilots. We align AI use cases with P&L, OEE, and regulatory needs in both highly regulated DACH environments and fast-moving UAE ecosystems.",
              "capabilities": [
                {
                  "title": "AI Opportunity Mapping",
                  "details": [
                    "Cross-functional workshops in DACH/UAE locations",
                    "Use case backlog tied to business KPIs and regulatory constraints (e.g., EU data protection, sector guidelines in UAE)",
                    "Value scoring: feasibility, impact, time-to-value",
                    "DACH-specific considerations: works councils, data protection, industry regulations"
                  ]
                },
                {
                  "title": "Agile AI MVPs & Pilots",
                  "details": [
                    "6–12 week MVPs with baseline/target KPI definition",
                    "Partner curation across Europe, UAE and other regions",
                    "Deployment in production-like environments with user onboarding",
                    "KPI reporting packs for stakeholders and boards"
                  ]
                },
                {
                  "title": "ROI-as-a-Service",
                  "details": [
                    "Continuous measurement of before/after metrics",
                    "ROI dashboards and executive summaries",
                    "Optimization and rollout support to additional sites/functions"
                  ]
                }
              ],
              "typical_kpis": [
                "20–40% process time reduction",
                "10–30% cost avoidance",
                "15–25% productivity uplift per FTE",
                "Increased regulatory and audit compliance scores"
              ]
            },
            "de": {
              "h2": "KI-Strategie & ROI-as-a-Service für DACH & VAE",
              "description": "Verwandeln Sie KI in ein Portfolio messbarer Initiativen, nicht in verstreute Piloten. Wir richten KI-Use-Cases an GuV, OEE und regulatorischen Anforderungen aus – sowohl in stark regulierten DACH-Umgebungen als auch in schnelllebigen VAE-Ökosystemen.",
              "capabilities": [
                {
                  "title": "KI-Opportunity-Mapping",

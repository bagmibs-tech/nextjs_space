        {
          "section_id": "how_we_work_teaser",
          "type": "content_block",
          "content": {
            "en": {
              "h2": "How We Work: From Strategy to 90-Day ROI",
              "body": "Whether you are a DACH manufacturer modernizing plants or a UAE healthcare provider scaling AI, we use the same proven 5-step orchestration framework to move from idea to measurable impact.",
              "steps": [
                "Strategy & AI-Business Opportunity Mapping",
                "Design & Partner Orchestration",
                "Agile Implementation (90-Day Sprints)",
                "ROI-as-a-Service",
                "Scale & Govern"
              ],
              "cta": {
                "text": "See the Full Delivery Model",
                "url": "/how-we-work"
              }
            },
            "de": {
              "h2": "Wie wir arbeiten: Von der Strategie zum ROI in 90 Tagen",
              "body": "Ob Sie ein DACH-Hersteller sind, der Werke modernisiert, oder ein VAE-Gesundheitsdienstleister, der KI skaliert – wir nutzen dasselbe bewährte 5-Schritte-Orchestrierungs-Framework, um von der Idee zur messbaren Wirkung zu gelangen.",
              "steps": [
                "Strategie & KI-Business-Opportunity-Mapping",
                "Design & Partner-Orchestrierung",
                "Agile Implementierung (90-Tage-Sprints)",
                "ROI-as-a-Service",
                "Skalierung & Governance"
              ],
              "cta": {
                "text": "Vollständiges Delivery-Modell ansehen",
                "url": "/how-we-work"
              }
            }
          }
        },
